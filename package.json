{
  "name": "@llanesleonardo/saas-platform",
  "version": "0.3.0",
  "private": false,
  "description": "Reusable multi-tenant SaaS platform (auth, workspaces, billing, jobs, storage, secrets, rate-limit, logging)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "import": "./dist/secrets/index.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "import": "./dist/rate-limit.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:smoke": "npm run build && npx tsx src/smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llanesleonardo/saas-platform.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "@azure/storage-blob": ">=12.0.0",
    "@azure/identity": ">=4.0.0",
    "@aws-sdk/client-s3": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "@azure/storage-blob": { "optional": true },
    "@azure/identity": { "optional": true },
    "@aws-sdk/client-s3": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
